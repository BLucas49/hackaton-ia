{{ .System }}<|end|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|end|>
{{ end }}<|assistant|>
"""

# 2. Paramètres d'inférence
PARAMETER temperature 0.2
PARAMETER num_ctx 4096
PARAMETER num_predict 512

# 3. Le prompt
